<Window x:Class="BusinessERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BusinessERP.Desktop.Views"
        Title="Business ERP | منصة إدارة الأعمال"
        Width="1460" Height="940" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI"
        FlowDirection="LeftToRight"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="NavigationColumn" Width="264" />
        </Grid.ColumnDefinitions>

        <!-- Main workspace. The desktop client communicates with the API only. -->
        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E6EAF2" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="نظرة عامة" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="مساحة العمل  /  إدارة الأعمال" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock x:Name="AuthStatusText" Text="إعداد الهوية مطلوب" Foreground="#69758D" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="150" TextWrapping="Wrap" />
                        <TextBox x:Name="TenantIdTextBox" Width="210" Height="34" Padding="8,5" IsEnabled="False"
                                 ToolTip="أدخل معرّف المستأجر الذي خصصه لك مشغّل المنصة" Margin="0,0,6,0" />
                        <Button x:Name="ApplyTenantButton" Content="تفعيل المستأجر" Click="ApplyTenantButton_Click"
                                IsEnabled="False" Padding="10,7" Margin="0,0,6,0" Background="#EEF3FF" Foreground="#315CC4" BorderThickness="0" Cursor="Hand" />
                        <Button x:Name="LoginButton" Content="تسجيل الدخول" Click="LoginButton_Click"
                                Padding="11,7" Margin="0,0,6,0" Background="#315CC4" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        <Button x:Name="LogoutButton" Content="إنهاء الجلسة" Click="LogoutButton_Click" Visibility="Collapsed"
                                Padding="11,7" Margin="0,0,0,0" Background="#FBEAEA" Foreground="#9D3030" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

<Border Grid.Row="1" Background="#F9FBFE" BorderBrush="#DDE5F0" BorderThickness="0,0,0,1" Padding="14,7">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="☰ القائمة" Click="ToggleNavigation_Click"
                                Padding="9,5" Margin="0,0,8,0" Background="#EEF2F8" Foreground="#344054" BorderThickness="0" />
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Button Content="الرئيسية" Tag="Overview" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="المالية" Tag="Accounting" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="المبيعات" Tag="Sales" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="المشتريات" Tag="Purchases" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="المخزون" Tag="Inventory" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="التقارير" Tag="Reports" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                                <Button Content="إدارة النظام" Tag="Settings" Click="RibbonNavigate_Click" Style="{StaticResource RibbonTabButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Column="2" x:Name="RibbonToggleButton" Content="تصغير الشريط ▴" Click="ToggleRibbon_Click"
                                Padding="9,5" Margin="8,0,0,0" Background="Transparent" Foreground="#52627C" BorderBrush="#DDE5F0" />
                    </Grid>
                    <StackPanel x:Name="RibbonActionsPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Content="＋ جديد" Click="RibbonNew_Click" Padding="10,8" Margin="0,0,4,0" Background="#315CC4" Foreground="White" BorderThickness="0" />
                                <Button Content="↻ تحديث" Click="RibbonRefresh_Click" Padding="10,8" Margin="0,0,4,0" Background="#EAF0FF" Foreground="#315CC4" BorderThickness="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Content="حفظ" IsEnabled="False" ToolTip="اختر نموذجًا يدعم الحفظ من مساحة العمل." Padding="10,8" Margin="0,0,4,0" />
                                <Button Content="تعديل" IsEnabled="False" ToolTip="التعديل متاح فقط عندما تدعمه حالة المستند وصلاحياتك." Padding="10,8" Margin="0,0,4,0" />
                                <Button Content="حذف" IsEnabled="False" ToolTip="الحذف غير مفعّل للمستندات المحاسبية؛ استخدم مسار تصحيح معتمد." Padding="10,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Content="طباعة" IsEnabled="False" ToolTip="الطباعة والمعاينة النهائية لم تُربطا بعد." Padding="10,8" Margin="0,0,4,0" />
                                <Button Content="Excel" IsEnabled="False" ToolTip="تصدير Excel غير منفذ لهذه الشاشة." Padding="10,8" Margin="0,0,4,0" />
                                <Button Content="PDF" IsEnabled="False" ToolTip="تصدير PDF غير منفذ لهذه الشاشة." Padding="10,8" />
                            </StackPanel>
                            <TextBox x:Name="GeneralSearchBox" Grid.Column="3" MinWidth="130" MaxWidth="280"
                                     Height="34" VerticalContentAlignment="Center" Padding="10,5"
                                     ToolTip="بحث في الشركات والعملاء والحسابات والمسودات المحمّلة للمستأجر الحالي"
                                     KeyDown="GeneralSearchBox_KeyDown"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="4" Content="بحث ⌕" Click="GeneralSearch_Click" Padding="12,8"
                                    Background="#FFFFFF" Foreground="#315CC4" BorderBrush="#D5DFF1" />
                        </Grid>
                        <TextBlock Text="أوامر المستند والسجلات المتاحة بحسب المرحلة الحالية؛ الأوامر غير المنفذة معطّلة عمدًا." Foreground="#8490A4" FontSize="10" Margin="4,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,26" FlowDirection="RightToLeft">
                        <Border Background="#EAF0FF" CornerRadius="18" Padding="28" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="منصة إدارة أعمالك" Foreground="#356AE6" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="مرحبًا بك في Business ERP" Foreground="#17233B" FontSize="28" FontWeight="Bold" Margin="0,7,0,7" />
                                    <TextBlock Text="تأسيس واضح، بيانات مترابطة، ونواة محاسبية يجري بناؤها واختبارها تدريجيًا." Foreground="#64718A" FontSize="14" TextWrapping="Wrap" MaxWidth="680" />
                                    <Border Background="White" CornerRadius="9" Padding="12,7" HorizontalAlignment="Right" Margin="0,18,0,0">
                                        <TextBlock Text="نسخة تأسيسية للتطوير والاختبار" Foreground="#315CC4" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Width="112" Height="112" Background="#D9E4FF" CornerRadius="24" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Border Width="60" Height="60" Background="#356AE6" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="B" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,22">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="إكمال التأسيس" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="أربع خطوات مقترحة قبل بدء إدخال العمليات المالية." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1F4FA" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
                                        <TextBlock Text="0 من 4 مكتملة" FontSize="12" Foreground="#65718A" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Border Background="#E8EDF6" Height="6" CornerRadius="3" Margin="0,0,0,12">
                                    <Border Background="#356AE6" Width="0" HorizontalAlignment="Right" CornerRadius="3" />
                                </Border>
                                <UniformGrid Columns="2">
                                    <Border Background="#FAFBFE" BorderBrush="#EDF0F6" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" Background="#E8EFFF" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,12,0">
                                                <TextBlock Text="1" Foreground="#356AE6" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="إنشاء الشركة" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="الاسم والرقم الضريبي والعملة الأساسية." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="#FAFBFE" BorderBrush="#EDF0F6" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" Background="#E8EFFF" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,12,0">
                                                <TextBlock Text="2" Foreground="#356AE6" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ضبط السنة المالية" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="الفترات المحاسبية وسياسة الإقفال." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="#FAFBFE" BorderBrush="#EDF0F6" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" Background="#E8EFFF" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,12,0">
                                                <TextBlock Text="3" Foreground="#356AE6" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="اختيار دليل الحسابات" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="ابدأ بقالب نشاط قابل للتخصيص." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="#FAFBFE" BorderBrush="#EDF0F6" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" Background="#E8EFFF" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,12,0">
                                                <TextBlock Text="4" Foreground="#356AE6" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="إعداد المستخدمين" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="الأدوار والفروع وحدود الوصول." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Text="تم ربط العملاء ومسودات المبيعات وحساب VAT الداخلي وترحيل القيد المتوازن. بقية الوحدات وقوائم التقارير وتجربة التوزيع ما زالت قيد التنفيذ." Foreground="#8A6A20" FontSize="12" Margin="4,14,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="وحدات النظام" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="اضغط على أي وحدة لعرض حالتها وخطة التفعيل." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="15" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="6 وحدات مخططة" Foreground="#65718A" FontSize="12" />
                            </Border>
                        </Grid>

                        <UniformGrid Columns="3" Margin="-6,0,-6,16">
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="Accounting" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#EAF0FF" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="GL" Foreground="#356AE6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="المحاسبة العامة" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="دليل الحسابات والقيود ودفتر الأستاذ." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="قيد التأسيس" Foreground="#946B13" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="Sales" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E8F8F1" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="AR" Foreground="#19865C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="المبيعات والعملاء" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="العملاء ومسودات البيع وتصنيف VAT الداخلي وترحيل الأثر المحاسبي إلى الأستاذ؛ لا يوجد إصدار قانوني أو تكامل ZATCA." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="مسودات أولية متصلة بالخادم" Foreground="#19865C" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="Purchases" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#FFF0E7" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="AP" Foreground="#C26D32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="المشتريات والموردون" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="فواتير الموردين والاستحقاقات والمردودات." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="لاحقًا" Foreground="#78839A" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="Inventory" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#F2ECFF" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="ST" Foreground="#7B56C5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="المخزون والمستودعات" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="الأصناف والحركة والتقييم والمستودعات." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="لاحقًا" Foreground="#78839A" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="CashBank" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E5F6F8" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="CB" Foreground="#177A8A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="الصناديق والبنوك" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="سندات القبض والصرف والتسويات البنكية." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="لاحقًا" Foreground="#78839A" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardStyle}" Tag="Tax" Click="Navigate_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#FFF0F4" CornerRadius="12" HorizontalAlignment="Right"><TextBlock Text="TX" Foreground="#BA456C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="#A7B1C4" VerticalAlignment="Center" /></Grid>
                                    <TextBlock Text="الضرائب والفوترة" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="الضريبة والفوترة الإلكترونية وتكامل فاتورة." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,15" />
                                    <TextBlock Text="يتطلب تحققًا رسميًا" Foreground="#946B13" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ApiStatusDot" Width="9" Height="9" Background="#D99B24" CornerRadius="5" Margin="0,0,8,0" />
                                        <TextBlock x:Name="ApiStatusTitle" Text="جارٍ فحص الاتصال بالخادم…" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ApiStatusDetail" Text="لم يتم فحص الاتصال بعد." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ApiLastChecked" Text="" Foreground="#98A1B3" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock x:Name="ApiAddressText" Text="API: http://localhost:5080" Foreground="#98A1B3" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="CheckApiButton" Grid.Column="1" Content="إعادة فحص الاتصال" Padding="16,10" Background="#EEF3FF" Foreground="#315CC4" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="CheckApiButton_Click" />
                            </Grid>
                        </Border>
                        <TextBlock Text="© 2026 Business ERP  •  نسخة تأسيسية للتطوير والاختبار، وليست للاستخدام المالي الإنتاجي." Foreground="#9AA3B4" FontSize="11" TextAlignment="Center" Margin="0,20,0,4" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ModulePlaceholderPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30" FlowDirection="RightToLeft">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="30">
                            <StackPanel>
                                <Border Width="58" Height="58" Background="#EAF0FF" CornerRadius="16" HorizontalAlignment="Right" Margin="0,0,0,20">
                                    <TextBlock x:Name="ModuleCodeText" Text="GL" Foreground="#356AE6" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ModulePageTitle" Text="المحاسبة العامة" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="ModulePageDescription" Text="دليل الحسابات والقيود ودفتر الأستاذ." Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,24" />
                                <Border Background="#FFF7E6" CornerRadius="10" Padding="16" Margin="0,0,0,22">
                                    <TextBlock x:Name="ModuleStatusText" Text="هذه الوحدة مخططة ولم تُفعّل بعد." Foreground="#8A651D" FontSize="13" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="حالة التنفيذ" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="تُنفّذ الوحدات بعد إكمال المصادقة، وعزل المستأجرين، واختبارات النواة المحاسبية. لا تُحفظ بيانات من هذه الشاشة حاليًا." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,22" />
                                <Button Content="العودة إلى نظرة عامة" Tag="Overview" Style="{StaticResource ModuleCardStyle}" HorizontalAlignment="Right" Padding="18,10" Click="Navigate_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <views:SalesWorkspaceControl x:Name="SalesWorkspacePanel" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="3" Background="#F1F4F9" BorderBrush="#DDE5F0" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="Business ERP" Foreground="#52627C" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="RibbonStatusText" Text="غير متصل · سجّل الدخول لتفعيل بيانات المستأجر" Foreground="#69758D"
                               FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="RTL · SAR" Foreground="#8490A4" FontSize="10" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- RTL navigation rail on the right side of the window. -->
        <Border Grid.Column="1" Background="{StaticResource BrandDarkBrush}">
            <DockPanel LastChildFill="True" Margin="18,22,18,18" FlowDirection="RightToLeft">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" Background="#356AE6" CornerRadius="13" Margin="0,0,12,0">
                            <TextBlock Text="B" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Business ERP" Foreground="White" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="منصة إدارة الأعمال" Foreground="#AEBBD6" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#26375D" CornerRadius="11" Padding="14" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="مساحة العمل" Foreground="#AEBBD6" FontSize="11" />
                            <TextBlock Text="بيئة جديدة" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,4" />
                            <TextBlock Text="لم يتم إعداد شركة بعد" Foreground="#AEBBD6" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="الرئيسية" Foreground="#8394B6" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,7" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Overview" Click="Navigate_Click" Background="#304775">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="19" Width="32" /><TextBlock Text="نظرة عامة" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <TextBlock Text="إدارة الأعمال" Foreground="#8394B6" FontSize="11" FontWeight="SemiBold" Margin="5,18,0,7" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Accounting" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="GL" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="المحاسبة العامة" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Sales" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="AR" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="المبيعات والعملاء" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Purchases" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="AP" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="المشتريات والموردون" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Inventory" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="ST" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="المخزون والمستودعات" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="CashBank" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="CB" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="الصناديق والبنوك" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Tax" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="TX" FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" /><TextBlock Text="الضرائب والفوترة" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="الإعدادات" Foreground="#8394B6" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,7" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Settings" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Width="32" /><TextBlock Text="الإعدادات والصلاحيات" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Background="#26375D" CornerRadius="9" Padding="12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="بيئة التطوير" Foreground="#DCE5F8" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="الإصدار 0.2.0 · WPF" Foreground="#AEBBD6" FontSize="10" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
