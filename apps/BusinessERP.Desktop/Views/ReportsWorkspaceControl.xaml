<UserControl x:Class="BusinessERP.Desktop.Views.ReportsWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F6F8FC">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="#DDE5F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24324A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="#315CC4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,28">
            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="التقارير المالية" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="ميزان المراجعة وقائمة الدخل والميزانية من القيود المرحلة المحفوظة في قاعدة البيانات." Foreground="#69758D" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="الشركة" Foreground="#69758D" FontSize="12" />
                            <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="من تاريخ" Foreground="#69758D" FontSize="12" />
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0">
                            <TextBlock Text="إلى تاريخ" Foreground="#69758D" FontSize="12" />
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0">
                            <TextBlock Text="الميزانية حتى" Foreground="#69758D" FontSize="12" />
                            <DatePicker SelectedDate="{Binding AsOfDate, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="تحديث التقارير" Command="{Binding LoadReportsCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TabControl x:Name="ReportsTabs" FlowDirection="RightToLeft" Background="White" BorderBrush="#DDE5F0">
                <TabItem Header="ميزان المراجعة">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding TrialBalanceSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding TrialBalanceRows}" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="110" />
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountNameAr}" Width="*" />
                                <DataGridTextColumn Header="النوع" Binding="{Binding AccountType}" Width="100" />
                                <DataGridTextColumn Header="مدين الحركة" Binding="{Binding DebitMovement, StringFormat=N2}" Width="120" />
                                <DataGridTextColumn Header="دائن الحركة" Binding="{Binding CreditMovement, StringFormat=N2}" Width="120" />
                                <DataGridTextColumn Header="رصيد مدين" Binding="{Binding DebitBalance, StringFormat=N2}" Width="120" />
                                <DataGridTextColumn Header="رصيد دائن" Binding="{Binding CreditBalance, StringFormat=N2}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="قائمة الدخل">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding IncomeSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding IncomeRows}" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding Category}" Width="110" />
                                <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="110" />
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountNameAr}" Width="*" />
                                <DataGridTextColumn Header="الاسم الإنجليزي" Binding="{Binding AccountNameEn}" Width="*" />
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="الميزانية العمومية">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding BalanceSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding BalanceRows}" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding Category}" Width="115" />
                                <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="110" />
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountNameAr}" Width="*" />
                                <DataGridTextColumn Header="الاسم الإنجليزي" Binding="{Binding AccountNameEn}" Width="*" />
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="قوالب REPX القديمة">
                    <DockPanel Margin="12">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="قوالب مستوردة من النظام السابق. هذه القائمة تفحص المخططات فقط؛ يلزم ربط مصادر البيانات وتوفير محرك DevExpress متوافق قبل المعاينة أو الطباعة."
                                   Foreground="#8A6A20" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding LegacyReportTemplates}" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="230" />
                                <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="150" />
                                <DataGridTextColumn Header="إصدار المخطط" Binding="{Binding SerializerVersion}" Width="120" />
                                <DataGridTextColumn Header="نوع الورق" Binding="{Binding PaperKind}" Width="100" />
                                <DataGridTextColumn Header="العناصر" Binding="{Binding ControlCount}" Width="75" />
                                <DataGridTextColumn Header="الحقول" Binding="{Binding BoundFieldCount}" Width="80" />
                                <DataGridTextColumn Header="أمثلة الحقول" Binding="{Binding BoundFields}" Width="*" />
                                <DataGridTextColumn Header="حالة الدمج" Binding="{Binding IntegrationStatus}" Width="270" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <TextBlock Text="تنبيه: هذه تقارير داخلية أولية من قيود POSTED فقط. تحتاج سياسة الإقفال والمراجعة المحاسبية قبل الاعتماد الرسمي؛ التدفقات النقدية غير متاحة." Foreground="#8A6A20" FontSize="11" TextWrapping="Wrap" Margin="2,12,2,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
