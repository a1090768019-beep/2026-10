<UserControl x:Class="BusinessERP.Desktop.Views.SettlementsWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Background="#F5F7FB" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="الشركة" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                          DisplayMemberPath="Name" SelectionChanged="Company_SelectionChanged" MinHeight="34"/>
                <TextBlock Grid.Column="2" Text="{Binding WorkspaceContextSummary}" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="16,0"/>
                <Button Grid.Column="3" Content="تحديث" Command="{Binding RefreshCommand}" Padding="18,8" MinWidth="90"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="سندات القبض والصرف · تُرحّل إلى قيود داخلية ولا تمثل تحصيلًا إلكترونيًا أو تسوية بنكية آلية."
                   Foreground="#64748B" Margin="4,0,4,12" TextWrapping="Wrap"/>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="سندات القبض">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="إنشاء سند قبض" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="رقم السند"/>
                                <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="العميل"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="فاتورة المبيعات المرحلة"/>
                                <ComboBox ItemsSource="{Binding SalesInvoices}" SelectedItem="{Binding SelectedSalesInvoice}" DisplayMemberPath="InvoiceNumber" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="تاريخ السند"/>
                                <DatePicker SelectedDate="{Binding ReceiptDate}" Margin="0,4,0,10"/>
                                <TextBlock Text="المبلغ"/>
                                <TextBox Text="{Binding ReceiptAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="ملاحظات"/>
                                <TextBox Text="{Binding ReceiptNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <Button Content="حفظ سند القبض كمسودة" Command="{Binding CreateReceiptCommand}" Padding="10,9" Margin="0,0,0,18"/>
                                <Separator Margin="0,0,0,14"/>
                                <TextBlock Text="ترحيل السند المحدد" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="الفترة المالية المفتوحة"/>
                                <ComboBox ItemsSource="{Binding FiscalPeriods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="حساب النقدية أو البنك"/>
                                <ComboBox ItemsSource="{Binding CashAccounts}" SelectedItem="{Binding SelectedCashAccount}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="حساب العملاء"/>
                                <ComboBox ItemsSource="{Binding ReceivableAccounts}" SelectedItem="{Binding SelectedReceivableAccount}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="رقم القيد"/>
                                <TextBox Text="{Binding ReceiptEntryNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <Button Content="ترحيل إلى الأستاذ العام" Command="{Binding PostReceiptCommand}" Padding="10,9"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="سجل سندات القبض" FontSize="17" FontWeight="SemiBold" Margin="4,4,4,12"/>
                            <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم السند" Binding="{Binding Number}" Width="*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="110"/>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="145"/>
                                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding JournalEntryId}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="سندات الصرف">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="إنشاء سند صرف" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="رقم السند"/>
                                <TextBox Text="{Binding PaymentNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="المورد"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="فاتورة الشراء المرحلة"/>
                                <ComboBox ItemsSource="{Binding PurchaseInvoices}" SelectedItem="{Binding SelectedPurchaseInvoice}" DisplayMemberPath="PurchaseNumber" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="تاريخ السند"/>
                                <DatePicker SelectedDate="{Binding PaymentDate}" Margin="0,4,0,10"/>
                                <TextBlock Text="المبلغ"/>
                                <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="ملاحظات"/>
                                <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <Button Content="حفظ سند الصرف كمسودة" Command="{Binding CreatePaymentCommand}" Padding="10,9" Margin="0,0,0,18"/>
                                <Separator Margin="0,0,0,14"/>
                                <TextBlock Text="ترحيل السند المحدد" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="الفترة المالية المفتوحة"/>
                                <ComboBox ItemsSource="{Binding FiscalPeriods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="حساب النقدية أو البنك"/>
                                <ComboBox ItemsSource="{Binding CashAccounts}" SelectedItem="{Binding SelectedCashAccount}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="حساب الموردين"/>
                                <ComboBox ItemsSource="{Binding PayableAccounts}" SelectedItem="{Binding SelectedPayableAccount}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" MinHeight="30"/>
                                <TextBlock Text="رقم القيد"/>
                                <TextBox Text="{Binding PaymentEntryNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" MinHeight="30"/>
                                <Button Content="ترحيل إلى الأستاذ العام" Command="{Binding PostPaymentCommand}" Padding="10,9"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="سجل سندات الصرف" FontSize="17" FontWeight="SemiBold" Margin="4,4,4,12"/>
                            <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم السند" Binding="{Binding Number}" Width="*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="110"/>
                                    <DataGridTextColumn Header="المورد" Binding="{Binding PartyName}" Width="*"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="145"/>
                                    <DataGridTextColumn Header="رقم القيد" Binding="{Binding JournalEntryId}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="أعمار الذمم">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="تحديث التقرير" Command="{Binding RefreshAgingReportsCommand}"
                                    Padding="18,8" MinWidth="120" Margin="12,0,0,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="عرض الأرصدة حتى تاريخ" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding AgingAsOfDate}" Width="160" MinHeight="30"/>
                                <TextBlock Text="تعرض التقارير الفواتير المرحلة والتسويات المرحلة بتاريخ التقرير فقط."
                                           Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabItem Header="الذمم المدينة">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding ReceivablesAgingSummary}" FontWeight="SemiBold"
                                           Margin="4,0,4,10" TextWrapping="Wrap"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ReceivablesAgingRows}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" MinHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding DocumentNumber}" Width="130"/>
                                        <DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/>
                                        <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="115"/>
                                        <DataGridTextColumn Header="قيمة الفاتورة" Binding="{Binding InvoiceAmount, StringFormat=N2}" Width="115"/>
                                        <DataGridTextColumn Header="المخصص" Binding="{Binding SettledAmount, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="المتبقي" Binding="{Binding OutstandingAmount, StringFormat=N2}" Width="110"/>
                                        <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysPastDue}" Width="90"/>
                                        <DataGridTextColumn Header="فئة التأخير" Binding="{Binding AgingBucketLabel}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <Button Content="السابق" Command="{Binding PreviousReceivablesAgingPageCommand}" Padding="14,6"/>
                                    <TextBlock Text="{Binding ReceivablesAgingPageLabel}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Content="التالي" Command="{Binding NextReceivablesAgingPageCommand}" Padding="14,6"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="الذمم الدائنة">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding PayablesAgingSummary}" FontWeight="SemiBold"
                                           Margin="4,0,4,10" TextWrapping="Wrap"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PayablesAgingRows}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" MinHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding DocumentNumber}" Width="130"/>
                                        <DataGridTextColumn Header="المورد" Binding="{Binding PartyName}" Width="*"/>
                                        <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="115"/>
                                        <DataGridTextColumn Header="قيمة الفاتورة" Binding="{Binding InvoiceAmount, StringFormat=N2}" Width="115"/>
                                        <DataGridTextColumn Header="المخصص" Binding="{Binding SettledAmount, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="المتبقي" Binding="{Binding OutstandingAmount, StringFormat=N2}" Width="110"/>
                                        <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysPastDue}" Width="90"/>
                                        <DataGridTextColumn Header="فئة التأخير" Binding="{Binding AgingBucketLabel}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <Button Content="السابق" Command="{Binding PreviousPayablesAgingPageCommand}" Padding="14,6"/>
                                    <TextBlock Text="{Binding PayablesAgingPageLabel}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Content="التالي" Command="{Binding NextPayablesAgingPageCommand}" Padding="14,6"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334155" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
