<UserControl x:Class="BusinessERP.Desktop.Views.PurchasesWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FlowDirection="RightToLeft"
             Background="#F6F8FC">
    <UserControl.Resources>
        <x:Array x:Key="VatTreatmentValues" Type="{x:Type sys:String}">
            <sys:String>StandardRated</sys:String>
            <sys:String>ZeroRated</sys:String>
            <sys:String>Exempt</sys:String>
            <sys:String>OutsideScope</sys:String>
        </x:Array>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="#DDE5F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AlternationCount" Value="2" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24324A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="#315CC4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,28">
            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="المشتريات والموردون" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="إدارة الموردين، وحفظ مسودات فواتير الشراء، وتسجيل حساب VAT الداخلي وتقرير البنود المحسوبة."
                                       Foreground="#69758D" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="تحديث البيانات" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="الشركة" Foreground="#69758D" FontSize="12" />
                            <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <TextBlock Text="العملة الأساسية" Foreground="#69758D" FontSize="12" />
                            <TextBlock Text="{Binding SelectedCurrency}" FontWeight="SemiBold" Margin="0,11,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="مسودة جديدة" Click="NewPurchase_Click" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#69758D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#B42318" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="إضافة مورد" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewSupplierCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="رمز المورد" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" ToolTip="اسم المورد" Margin="6,0" />
                        <TextBox Grid.Column="2" Text="{Binding NewSupplierTaxNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="الرقم الضريبي" Margin="6,0" />
                        <TextBox Grid.Column="3" Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" ToolTip="الهاتف" Margin="6,0" />
                        <TextBox Grid.Column="4" Text="{Binding NewSupplierEmail, UpdateSourceTrigger=PropertyChanged}" ToolTip="البريد الإلكتروني" Margin="6,0" />
                        <Button Grid.Column="5" Content="حفظ المورد" Command="{Binding CreateSupplierCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding Suppliers}" Height="150" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="120" />
                            <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding TaxNumber}" Width="160" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="125" />
                            <DataGridTextColumn Header="البريد" Binding="{Binding Email}" Width="190" />
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="إنشاء مسودة فاتورة مورد" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="يحفظ هذا الإجراء مسودة داخلية فقط؛ لا ينشئ قيدًا دفتريًا ولا يؤكد قابلية استرداد ضريبة المدخلات."
                               FontSize="11" Foreground="#8A6A20" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="المورد" FontSize="12" Foreground="#69758D" />
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="رقم المستند الداخلي" FontSize="12" Foreground="#69758D" />
                            <TextBox Text="{Binding PurchaseNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0">
                            <TextBlock Text="رقم فاتورة المورد" FontSize="12" Foreground="#69758D" />
                            <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0">
                            <TextBlock Text="تاريخ الفاتورة" FontSize="12" Foreground="#69758D" />
                            <DatePicker SelectedDate="{Binding IssueDate, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="6,0">
                            <TextBlock Text="تاريخ الاستحقاق" FontSize="12" Foreground="#69758D" />
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding PurchaseNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             ToolTip="ملاحظات المستند (اختياري)" />
                    <TextBlock Text="بنود المستند" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <DataGrid ItemsSource="{Binding NewPurchaseLines}" SelectedItem="{Binding SelectedNewPurchaseLine, Mode=TwoWay}" Height="180"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="وصف البند" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إضافة بند" Command="{Binding AddPurchaseLineCommand}" />
                        <Button Content="حذف البند المحدد" Command="{Binding RemovePurchaseLineCommand}" Background="#EEF2F8" Foreground="#344054" />
                        <Button Content="حفظ المسودة" Command="{Binding CreatePurchaseDraftCommand}" Background="#146C4A" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="مسودات فواتير الموردين" FontSize="16" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding PurchaseDrafts}" SelectedItem="{Binding SelectedPurchaseDraft, Mode=TwoWay}"
                              Height="210" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المستند" Binding="{Binding PurchaseNumber}" Width="130" />
                            <DataGridTextColumn Header="فاتورة المورد" Binding="{Binding SupplierInvoiceNumber}" Width="140" />
                            <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="110" />
                            <DataGridTextColumn Header="قبل الضريبة" Binding="{Binding SubtotalAmount, StringFormat=N2}" Width="130" />
                            <DataGridTextColumn Header="VAT" Binding="{Binding VatAmount, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120" />
                            <DataGridTextColumn Header="حالة VAT" Binding="{Binding TaxCalculationStatus}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding SelectedDraftStatusSummary}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <Border Background="#F4F7FB" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ربط القيد المحاسبي" FontWeight="SemiBold" />
                            <TextBlock Text="اختر فترة مفتوحة وحساب تكلفة الشراء وحساب الموردين. حساب ضريبة المدخلات اختياري؛ عند اختياره يفصل VAT في حساب أصل بناءً على قرارك، وعند تركه فارغًا تُحمّل VAT ضمن تكلفة الشراء."
                                       FontSize="11" Foreground="#69758D" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="الفترة المالية" FontSize="12" Foreground="#69758D" />
                                    <ComboBox ItemsSource="{Binding OpenFiscalPeriods}" SelectedItem="{Binding SelectedFiscalPeriod, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="حساب تكلفة الشراء" FontSize="12" Foreground="#69758D" />
                                    <ComboBox ItemsSource="{Binding PurchaseDebitAccounts}" SelectedItem="{Binding SelectedPurchaseDebitAccount, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0">
                                    <TextBlock Text="حساب الموردين (دائن)" FontSize="12" Foreground="#69758D" />
                                    <ComboBox ItemsSource="{Binding PayableAccounts}" SelectedItem="{Binding SelectedPayableAccount, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="6,0">
                                    <TextBlock Text="حساب VAT (اختياري)" FontSize="12" Foreground="#69758D" />
                                    <ComboBox ItemsSource="{Binding InputVatAccounts}" SelectedItem="{Binding SelectedInputVatAccount, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding SelectedDraftLines}" Height="190" IsReadOnly="{Binding IsSelectedDraftPosted}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" IsReadOnly="True" Width="45" />
                            <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N4}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N4}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <DataGridComboBoxColumn Header="معالجة VAT" SelectedItemBinding="{Binding VatTreatment, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{StaticResource VatTreatmentValues}" Width="140" />
                            <DataGridTextColumn Header="سبب التصنيف (لغير القياسي)" Binding="{Binding VatTreatmentReason, UpdateSourceTrigger=PropertyChanged}" Width="210" />
                            <DataGridTextColumn Header="VAT المحسوبة" Binding="{Binding VatAmount, StringFormat=N2}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" IsReadOnly="True" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,9,0,0">
                        <Button Content="حساب VAT وحفظها على المسودة" Command="{Binding CalculateSelectedDraftVatCommand}" />
                        <Button Content="ترحيل القيد إلى دفتر الأستاذ" Command="{Binding PostSelectedDraftToLedgerCommand}"
                                Background="#146C4A" />
                    </StackPanel>
                    <TextBlock Text="الترحيل ينشئ قيدًا مزدوجًا داخليًا ويربطه بمسودة الشراء مرة واحدة. لا يُصدر فاتورة ضريبية ولا يثبت استرداد VAT."
                               Foreground="#8A6A20" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="تقرير تفاصيل VAT للمشتريات" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VatReportSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="من تاريخ" VerticalAlignment="Center" Foreground="#69758D" Margin="0,0,8,0" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding ReportFromDate, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="إلى تاريخ" VerticalAlignment="Center" Foreground="#69758D" Margin="14,0,8,0" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ReportToDate, Mode=TwoWay}" />
                        <TextBlock Grid.Column="4" Text="يعرض المسودات المحسوبة VAT فقط" VerticalAlignment="Center" Foreground="#8A6A20" Margin="10,0" />
                        <Button Grid.Column="5" Content="تحديث التقرير" Command="{Binding LoadVatReportCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding PurchaseVatRows}" Height="260" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المستند" Binding="{Binding PurchaseNumber}" Width="125" />
                            <DataGridTextColumn Header="فاتورة المورد" Binding="{Binding SupplierInvoiceNumber}" Width="135" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="105" />
                            <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding SupplierTaxNumber}" Width="130" />
                            <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="180" />
                            <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="نسبة VAT" Binding="{Binding VatRatePercent, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="VAT" Binding="{Binding VatAmount, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,9,0,0">
                        <Button Content="السابق" Command="{Binding PreviousVatPageCommand}" />
                        <TextBlock Text="{Binding VatReportPageSummary}" VerticalAlignment="Center" Margin="10,0" />
                        <Button Content="التالي" Command="{Binding NextVatPageCommand}" />
                    </StackPanel>
                    <TextBlock Text="تنبيه: هذا تقرير داخلي لمسودات المشتريات التي حُسبت VAT لها. لا يثبت اعتماد فاتورة المورد أو قابلية استرداد ضريبة المدخلات، ولا يتضمن ترحيلًا محاسبيًا أو إشعارًا بإرسال إلى ZATCA."
                               Foreground="#8A6A20" FontSize="11" TextWrapping="Wrap" Margin="2,10,2,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
